# ═══════════════════════════════════════════════════════════════════════════
#  KESTREL — environment template
#  Copy to `.env` and fill in. `.env` is gitignored; this file must only ever
#  contain placeholders.
#
#  KEY SCOPING RULE — this matters, read it:
#    * Keys WITHOUT the NEXT_PUBLIC_ prefix are server-side only. They are read
#      by the Python API and never serialised to the browser. Model providers
#      live here.
#    * Keys WITH the NEXT_PUBLIC_ prefix are compiled into client JavaScript and
#      are therefore PUBLIC. Only put things there that are safe to expose, and
#      lock them down at the provider (domain allow-list).
# ═══════════════════════════════════════════════════════════════════════════

# ── Model providers (SERVER-SIDE ONLY — never expose to the browser) ───────

# NVIDIA NIM. Free tier, no card: https://build.nvidia.com
# Powers the VLM, open-vocabulary detector, NV-CLIP, embeddings and reranker.
# REQUIRED for live mode. Without it, KESTREL runs in cassette-replay mode.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq. Free tier: https://console.groq.com
# OPTIONAL. Low-latency text inference — used for the provider-racing demo and
# as a failover when NIM is rate-limited (free tier is ~40 RPM).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Map tiles (CLIENT-SIDE — public by necessity) ─────────────────────────

# MapTiler: https://cloud.maptiler.com
# The browser fetches vector tiles directly, so this key CANNOT be hidden.
# → Restrict it by domain (origin allow-list) in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Runtime configuration ─────────────────────────────────────────────────

# live      → call real model APIs, record cassettes as we go
# replay    → serve committed cassettes; deterministic, zero cost, NO KEY NEEDED
# record    → like live, but overwrite existing cassettes
KESTREL_MODE=replay

# ── Model roster ──────────────────────────────────────────────────────────
# Every ID below was verified against the live API, not taken from docs. Rerun
# `uv run python scripts/probe_models.py` to re-verify; see docs/adr/0001 for the
# measurements and why each tier was chosen.

# Perception tier 3 — semantic captioning on gated frames.
# 11B measured 1.28s and caught vehicle + colour + person; the 8B nemotron is
# marginally faster (0.86s) but missed the person, which is the wrong failure
# mode for a security system.
KESTREL_VLM_FAST=meta/llama-3.2-11b-vision-instruct

# Tier 4 — deep re-look. Measured 57-84s, so it runs ASYNCHRONOUSLY and off the
# critical path; results upgrade a record after the fact rather than blocking it.
KESTREL_VLM_DEEP=meta/llama-3.2-90b-vision-instruct

# Optional mid tier (measured 29s). Off by default; the async deep tier covers it.
KESTREL_VLM_MID=nvidia/nemotron-nano-12b-v2-vl

# Joint image+text embeddings — the basis of CLIP-style frame search and entity
# re-ID. 2048-d, and image/text land in the SAME space (verified).
# NOTE: nvidia/nvclip appears in the catalogue but its NVCF function is not
# provisioned for developer keys (404). This model is the working equivalent.
KESTREL_VL_EMBED=nvidia/llama-nemotron-embed-vl-1b-v2

# Text-only embeddings for captions and summaries (1024-d).
KESTREL_EMBED=nvidia/nv-embedqa-e5-v5

# Reasoning LLM. Groq is PRIMARY on measured latency: 227ms vs 83s for the same
# model class on NIM. NIM is the fallback, not the default.
# Re-measured 2026-08-06: meta/llama-3.3-70b-instruct on NIM stopped responding
# entirely (45s timeout, repeatedly). meta/llama-3.1-70b-instruct is the same
# capability class and answered in 554ms, so it is the fallback instead. A
# fallback that never returns is worse than none: every rate-limited request
# burns the full timeout before degrading, which reads to an operator as the
# assistant hanging.
KESTREL_LLM=llama-3.3-70b-versatile
KESTREL_LLM_PROVIDER=groq
KESTREL_LLM_FALLBACK=meta/llama-3.1-70b-instruct

# No hosted reranker is available to developer keys, so hybrid retrieval fuses
# with Reciprocal Rank Fusion and optionally reranks with the LLM above.
KESTREL_RERANK_STRATEGY=rrf+llm

# ── Local GPU inference (tiers 1 + 1.5) ───────────────────────────────────
# Open-vocabulary detection is NOT available on the hosted API, so promptable
# detection runs locally. This also makes the edge/cloud split real rather than
# theoretical. Install with: uv sync --extra local-gpu
# Falls back to a closed-set detector, then to gate-only heuristics, if absent.
# Set to 1 if the HuggingFace Hub is unreachable on your network. Stops
# huggingface_hub retrying with backoff on every start; the detector falls back to
# YOLO11, whose weights come from GitHub releases. Leave unset if the Hub works —
# the open-vocabulary Grounding DINO backend is preferred when available.
# HF_HUB_OFFLINE=1

KESTREL_LOCAL_DETECTOR=true
KESTREL_LOCAL_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
KESTREL_LOCAL_DETECTOR_FALLBACK=PekingU/rtdetr_r50vd_coco_o365
KESTREL_DETECTOR_DEVICE=auto

# Storage
KESTREL_DB=data/kestrel.db

# API surface
KESTREL_API_HOST=127.0.0.1
KESTREL_API_PORT=8000

# Where the browser reaches the API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
